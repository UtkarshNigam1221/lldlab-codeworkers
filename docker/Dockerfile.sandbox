FROM alpine:3.19

RUN apk add --no-cache \
    gcc \
    g++ \
    musl-dev \
    python3 \
    openjdk17-jre \
    nodejs \
    npm \
    go \
    && npm install -g typescript ts-node \
    && adduser -D -u 1001 sandbox \
    && mkdir -p /workspace \
    && chown -R sandbox:sandbox /workspace \
    && rm -rf /var/cache/apk/* /root/.npm /tmp/*

WORKDIR /workspace

USER sandbox

CMD ["sleep", "infinity"]
